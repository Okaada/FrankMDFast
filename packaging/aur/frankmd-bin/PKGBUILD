package() {
  cd "frankmd-$pkgver-linux-$CARCH"
  install -Dm755 bin/frankmd "$pkgdir/usr/bin/frankmd"
  cp -r share "$pkgdir/usr/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
