pkgver=@VERSION@
pkgrel=1
pkgdesc="Markdown notes and blog editor with live preview, Vim mode and AI tools (native FrankMD)"
arch=('x86_64' 'aarch64')
url="https://github.com/akitaonrails/FrankMDFast"
license=('MIT')
depends=('fontconfig' 'libxcb' 'libxkbcommon' 'libxkbcommon-x11' 'vulkan-icd-loader' 'wayland')
optdepends=('fcitx5: input method support')
provides=('frankmd')
conflicts=('frankmd')
options=('!strip' '!debug')
source_x86_64=("$url/releases/download/v$pkgver/frankmd-$pkgver-linux-x86_64.tar.gz")
source_aarch64=("$url/releases/download/v$pkgver/frankmd-$pkgver-linux-aarch64.tar.gz")
sha256sums_x86_64=('@SHA256_X86_64@')
